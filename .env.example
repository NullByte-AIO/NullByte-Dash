# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Discord OAuth Configuration
# Set your Redirect URI in Discord Dev Portal to: [YOUR_SUPABASE_URL]/auth/v1/callback
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
ALLOWED_DISCORD_IDS=123456789,987654321

# KickBot Backend API URL
# In development, this is usually http://localhost:3001
# In production, set this to your deployed backend URL (e.g. https://your-api.com)
KICKBOT_BACKEND_URL=http://localhost:3001
# Note: KICKBOT_API_SECRET was changed to API_SECRET on the backend, but if the frontend sends x-api-key, it needs to match the backend's API_SECRET.
KICKBOT_API_SECRET=your_super_secret_api_key_here
